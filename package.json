{
  "name": "dota2-group-assistant",
  "private": true,
  "scripts": {
    "dev": "node scripts/clean-ports.mjs && pnpm --parallel --filter @dota/server --filter @dota/web dev",
    "dev:server": "node scripts/clean-ports.mjs && pnpm --filter @dota/server dev",
    "dev:web": "node scripts/clean-ports.mjs && pnpm --filter @dota/web dev",
    "build": "pnpm -r build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "pnpm -r typecheck",
    "lint": "oxlint .",
    "fmt": "oxfmt .",
    "fmt:check": "oxfmt --check .",
    "prepare": "husky",
    "commit:check": "commitlint --from HEAD~1 --to HEAD"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "husky": "^9.1.7",
    "jsdom": "^30.0.1",
    "lint-staged": "^17.3.0",
    "oxfmt": "^0.63.0",
    "oxlint": "latest",
    "vitest": "^4.1.10"
  },
  "packageManager": "pnpm@11.21.0"
}
